generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Company {
  id           String        @id @default(uuid()) @db.Char(36)
  legalName    String        @db.VarChar(150)
  tradeName    String        @db.VarChar(150)
  document     String        @unique @db.VarChar(20)
  email        String?       @db.VarChar(150)
  phone        String?       @db.VarChar(30)
  zipCode      String?       @db.VarChar(10)
  street       String?       @db.VarChar(150)
  number       String?       @db.VarChar(20)
  complement   String?       @db.VarChar(100)
  neighborhood String?       @db.VarChar(100)
  city         String?       @db.VarChar(100)
  state        String?       @db.Char(2)
  status       CompanyStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  categories   Category[]
  clients      Client[]
  orders       Order[]
  products     Product[]
  users        User[]

  @@index([status])
  @@index([tradeName])
}

model User {
  id           String     @id @default(uuid()) @db.Char(36)
  companyId    String     @db.Char(36)
  name         String     @db.VarChar(150)
  email        String     @db.VarChar(150)
  passwordHash String     @db.VarChar(255)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  orders       Order[]
  company      Company    @relation(fields: [companyId], references: [id])
  roles        UserRole[]

  @@unique([companyId, email])
  @@index([companyId])
  @@index([status])
}

model Role {
  id          String           @id @default(uuid()) @db.Char(36)
  name        String           @unique @db.VarChar(100)
  description String?          @db.VarChar(255)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String           @id @default(uuid()) @db.Char(36)
  name        String           @unique @db.VarChar(100)
  description String?          @db.VarChar(255)
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model UserRole {
  userId String @db.Char(36)
  roleId String @db.Char(36)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String     @db.Char(36)
  permissionId String     @db.Char(36)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Client {
  id           String       @id @default(uuid()) @db.Char(36)
  companyId    String       @db.Char(36)
  name         String       @db.VarChar(150)
  document     String?      @db.VarChar(20)
  email        String?      @db.VarChar(150)
  phone        String?      @db.VarChar(30)
  zipCode      String?      @db.VarChar(10)
  street       String?      @db.VarChar(150)
  number       String?      @db.VarChar(20)
  complement   String?      @db.VarChar(100)
  neighborhood String?      @db.VarChar(100)
  city         String?      @db.VarChar(100)
  state        String?      @db.Char(2)
  status       ClientStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  company      Company      @relation(fields: [companyId], references: [id])
  orders       Order[]

  @@unique([companyId, document])
  @@index([companyId])
  @@index([name])
  @@index([status])
}

model Category {
  id          String         @id @default(uuid()) @db.Char(36)
  companyId   String         @db.Char(36)
  name        String         @db.VarChar(100)
  description String?        @db.VarChar(255)
  status      CategoryStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  company     Company        @relation(fields: [companyId], references: [id])
  products    Product[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([status])
}

model Product {
  id            String        @id @default(uuid()) @db.Char(36)
  companyId     String        @db.Char(36)
  categoryId    String        @db.Char(36)
  code          String        @db.VarChar(50)
  name          String        @db.VarChar(150)
  description   String?       @db.Text
  price         Decimal       @db.Decimal(12, 2)
  stockQuantity Decimal       @default(0.000) @db.Decimal(12, 3)
  minimumStock  Decimal       @default(0.000) @db.Decimal(12, 3)
  status        ProductStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  orderItems    OrderItem[]
  category      Category      @relation(fields: [categoryId], references: [id])
  company       Company       @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
  @@index([companyId])
  @@index([categoryId])
  @@index([name])
  @@index([status])
}

model Order {
  id        String      @id @default(uuid()) @db.Char(36)
  companyId String      @db.Char(36)
  clientId  String      @db.Char(36)
  userId    String      @db.Char(36)
  number    Int
  status    OrderStatus @default(DRAFT)
  orderDate DateTime    @default(now())
  subtotal  Decimal     @db.Decimal(12, 2)
  discount  Decimal     @default(0.00) @db.Decimal(12, 2)
  total     Decimal     @db.Decimal(12, 2)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  client    Client      @relation(fields: [clientId], references: [id])
  company   Company     @relation(fields: [companyId], references: [id])
  user      User        @relation(fields: [userId], references: [id])
  items     OrderItem[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([clientId])
  @@index([userId])
  @@index([status])
  @@index([orderDate])
}

model OrderItem {
  id        String   @id @default(uuid()) @db.Char(36)
  orderId   String   @db.Char(36)
  productId String   @db.Char(36)
  quantity  Decimal  @db.Decimal(12, 3)
  unitPrice Decimal  @db.Decimal(12, 2)
  discount  Decimal  @default(0.00) @db.Decimal(12, 2)
  subtotal  Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  CANCELLED
  COMPLETED
}
